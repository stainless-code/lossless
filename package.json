{
  "name": "lossless-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint:ci": "vp lint --quiet",
    "test": "vp test",
    "test:coverage": "vp test --coverage --coverage.reporter=lcov",
    "coverage:codemap": "codemap ingest-coverage coverage/lcov.info && node -e \"fs.rmSync('coverage',{recursive:true,force:true})\"",
    "opencode:check": "bun scripts/opencode-live.ts",
    "opencode:smoke": "bun scripts/opencode-smoke.ts",
    "opencode:compact": "bun scripts/opencode-compact.ts",
    "pack": "vp run --filter ./packages/core prepack && vp run --filter ./packages/pi prepack && vp run --filter ./packages/opencode prepack",
    "changeset": "changeset",
    "version": "changeset version && vp fmt packages/*/CHANGELOG.md",
    "release": "changeset publish",
    "prepare": "vp config || true",
    "eval": "bun scripts/eval-long-context.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@vitest/coverage-v8": "5.0.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5",
    "vite-plus": "1.4.0"
  }
}
