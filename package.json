{
  "name": "lossless-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint:ci": "vp lint --quiet",
    "test": "vp test",
    "test:coverage": "vp test --coverage --coverage.reporter=lcov",
    "coverage:codemap": "codemap ingest-coverage coverage/lcov.info && node -e \"fs.rmSync('coverage',{recursive:true,force:true})\"",
    "pack": "vp run --filter ./packages/core prepack && vp run --filter ./packages/pi prepack",
    "changeset": "changeset",
    "version": "changeset version && vp fmt packages/*/CHANGELOG.md",
    "release": "changeset publish",
    "prepare": "vp config || true",
    "eval": "bun scripts/eval-long-context.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/node": "^22",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "^5.7.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@vitest/coverage-v8": "5.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vitest": "5.0.1",
    "vite-plus": "1.0.0-rc.0"
  }
}
