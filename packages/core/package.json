{
  "name": "lossless-core",
  "version": "0.1.1",
  "description": "The Lossless Context Management engine: stores every message verbatim, swaps aged context for searchable pointers, and takes a host for the model calls it cannot make itself.",
  "keywords": [
    "compaction",
    "context",
    "lcm",
    "llm",
    "memory",
    "retrieval",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/stainless-code/lossless#readme",
  "bugs": "https://github.com/stainless-code/lossless/issues",
  "license": "MIT",
  "author": "stainless-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainless-code/lossless.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "pack:watch": "vp pack --watch",
    "prepack": "vp pack",
    "prepublishOnly": "vp check && vp test && intent validate"
  },
  "dependencies": {
    "typebox": ">=1.4.3 <2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
