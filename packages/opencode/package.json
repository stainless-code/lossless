{
  "name": "opencode-lossless",
  "version": "0.1.3",
  "description": "Lossless Context Management for OpenCode v2: long sessions keep working past the point where the model would forget, and every verbatim message stays searchable and readable.",
  "keywords": [
    "coding-agent",
    "context",
    "lcm",
    "memory",
    "opencode",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/stainless-code/lossless#readme",
  "bugs": {
    "url": "https://github.com/stainless-code/lossless/issues"
  },
  "license": "MIT",
  "author": "stainless-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainless-code/lossless.git",
    "directory": "packages/opencode"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "pack:watch": "vp pack --watch",
    "prepack": "vp pack",
    "prepublishOnly": "vp check && vp test && intent validate"
  },
  "devDependencies": {
    "@opencode/ai": "2.1.4",
    "@opencode/plugin": "2.1.4",
    "lossless-core": "workspace:*"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
