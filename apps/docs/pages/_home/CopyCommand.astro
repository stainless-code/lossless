---
import Icon from "blume/components/Icon.astro";

interface Props {
	command: string;
	hostCommand?: boolean;
	size?: "default" | "compact";
	tone?: "surface" | "muted" | "violet";
}

const { command, hostCommand = false, size = "default", tone = "surface" } = Astro.props;
const compact = size === "compact";

const frame =
	tone === "violet"
		? "border-transparent bg-white"
		: tone === "muted"
			? "border-transparent bg-muted"
			: "border-border bg-[var(--landing-surface)]";
const codeClass = compact
	? "text-[11px]"
	: tone === "violet"
		? "text-base text-[#18181b]"
		: "text-base text-foreground";
const promptClass = compact
	? "text-[12px]"
	: tone === "violet"
		? "text-base text-[#6b6b75]"
		: "text-base text-[var(--landing-faint)]";
const buttonClass = compact
	? "bg-transparent text-[var(--landing-faint)] hover:bg-muted hover:text-foreground"
	: tone === "violet"
		? "bg-[#f4f4f5] text-[#52525b] hover:text-[#18181b]"
		: "bg-muted text-muted-foreground hover:text-foreground";
---

<div
  class={`flex w-fit max-w-full items-center border ${compact ? "gap-[8px] rounded-lg py-[10px] pr-[8px] pl-3" : tone === "violet" ? "gap-[14px] rounded-[10px] py-3 pr-3 pl-5" : "gap-4 rounded-xl py-2.5 pr-2.5 pl-5"} ${frame}`}
  data-host-command={hostCommand ? "true" : undefined}
  data-landing-command
>
  <span aria-hidden="true" class={`select-none font-mono ${promptClass}`}>$</span>
  <code class={`min-w-0 flex-1 truncate text-left font-mono ${codeClass}`} data-landing-command-text>{command}</code>
  <button
    aria-label={`Copy ${command}`}
    class={`inline-flex ${compact ? "size-6" : "size-8"} shrink-0 cursor-pointer items-center justify-center rounded-lg transition-colors ${buttonClass}`}
    data-landing-copy
    data-command={command}
    type="button"
  >
    <Icon name="copy" size={compact ? 13 : tone === "violet" ? 14 : 15} />
  </button>
</div>

<script is:inline>
  (() => {
    if (document.documentElement.dataset.landingCopyBound === "true") return;
    document.documentElement.dataset.landingCopyBound = "true";
    const CHECK =
      '<svg height="15" width="15" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>';
    document.addEventListener("click", async (e) => {
      const target = e.target instanceof Element ? e.target : null;
      const button = target?.closest("[data-landing-copy]");
      if (!(button instanceof HTMLElement)) return;
      try {
        await navigator.clipboard.writeText(button.dataset.command ?? "");
      } catch {
        return;
      }
      const original = button.innerHTML;
      button.innerHTML = CHECK;
      setTimeout(() => {
        button.innerHTML = original;
      }, 1500);
    });
  })();
</script>
