---
import { contentHref } from "blume/components/content/base-href.ts";
import Icon from "blume/components/Icon.astro";
import CopyCommand from "./CopyCommand.astro";
import SectionHeader from "./SectionHeader.astro";
import { OPENCODE_ICON } from "../../harness-icons.ts";

const shells = [
	{
		name: "pi-lossless",
		icon: "/logos/pi-color.svg",
		title: "The Pi extension",
		body: "The recall tools, the cockpit and the commands, with the engine inlined so the installed package stays a single artifact.",
		command: "pi install npm:pi-lossless",
	},
	{
		name: "opencode-lossless",
		icon: OPENCODE_ICON,
		title: "The OpenCode plugin",
		body: "The same engine as a plugin: recall tools, the swap point, and a per-session sidecar beside the session file.",
		command: "opencode plugin add opencode-lossless",
	},
	{
		name: "deepseek-lossless",
		icon: "/logos/deepseek.svg",
		title: "The DeepSeek adapter",
		body: "The same engine as a profile bundle: recall tools, the compaction backend, and a per-session sidecar beside the session file.",
		command: "dsh plugin --profile headless add deepseek-lossless",
	},
];
---

<section class="bg-muted landing-gutter py-16 sm:py-[100px]">
  <div class="mx-auto max-w-[1160px]">
    <SectionHeader
      eyebrow="INSTALL"
      title="One engine, a shell for every host."
      sub="lossless-core is the engine. A shell puts it inside one host: same engine, same two ports, a different installer."
    />

    <div class="mt-12 flex flex-col gap-5">
      <div class="flex flex-col gap-[18px] rounded-[14px] border border-border bg-[var(--landing-surface)] p-6">
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
          <div class="flex flex-col gap-1.5">
            <p class="font-mono text-accent text-sm">lossless-core</p>
            <h3 class="font-display font-semibold text-2xl text-foreground tracking-tight">
              The engine
            </h3>
          </div>
          <div class="w-full md:w-[340px] [&>[data-landing-command]]:w-full">
            <CopyCommand command="npm install lossless-core" size="compact" tone="muted" />
          </div>
        </div>

        <p class="text-muted-foreground text-sm leading-relaxed">
          Ingest, compaction and retrieval behind a two-port host contract. One
          engine runs in Pi, OpenCode v2, or DeepSeek. Each install is one
          package.
        </p>

        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            [
              "Verbatim ingest with FTS5",
              "Summary pointers and a DAG frontier",
              "No runtime dependencies",
            ].map((bullet) => (
              <li class="flex items-center gap-2 text-[13px] text-muted-foreground">
                <Icon class="shrink-0 text-accent" name="check" size={13} />
                {bullet}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {
          shells.map((shell) => (
            <div class="flex min-h-[240px] flex-col gap-3 rounded-[14px] border border-border bg-[var(--landing-surface)] p-5">
              <div class="flex items-center gap-2">
                <Icon name={shell.icon} size={13} />
                <p class="font-mono text-[13.5px] text-accent">{shell.name}</p>
              </div>
              <h3 class="font-display font-semibold text-[17px] text-foreground tracking-tight">
                {shell.title}
              </h3>
              <p class="text-[13px] text-muted-foreground leading-relaxed">{shell.body}</p>
              <div class="mt-auto [&>[data-landing-command]]:w-full">
                <CopyCommand command={shell.command} size="compact" tone="muted" />
              </div>
            </div>
          ))
        }

        <div class="relative flex h-[240px] flex-col justify-center gap-2.5 overflow-hidden rounded-[14px] border border-border bg-background p-5 md:col-span-2 xl:col-span-1">
          <div aria-hidden="true" class="landing-hatch absolute -inset-5"></div>
          <p class="relative font-mono text-[13.5px] text-[var(--landing-faint)]">
            your-host-lossless
          </p>
          <h3 class="relative font-display font-semibold text-[17px] text-muted-foreground tracking-tight">
            The next shell
          </h3>
          <p class="relative text-[13px] text-[var(--landing-faint)] leading-[20px]">
            One shell per host. Same engine, same two ports.
          </p>
          <div class="relative flex items-center gap-2">
            <span class="font-mono text-[9px] text-[var(--landing-faint)] tracking-[0.08em]">
              NEXT
            </span>
            <span class="text-[12px] text-[var(--landing-faint)]">no installer yet</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 text-center">
      <a
        class="inline-flex items-center gap-1.5 font-medium text-accent transition-opacity hover:opacity-80"
        href={contentHref("/guides/pi/getting-started")}
      >
        Getting started
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</section>
