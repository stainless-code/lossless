---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import FinalCta from "./_home/FinalCta.astro";
import Hero from "./_home/Hero.astro";
import HowItWorks from "./_home/HowItWorks.astro";
import Packages from "./_home/Packages.astro";
import Projection from "./_home/Projection.astro";
import RecallTools from "./_home/RecallTools.astro";
import Stats from "./_home/Stats.astro";
import Zones from "./_home/Zones.astro";
import Footer from "../components/blume/Footer.astro";

const { config } = data;
const pageTitle = `${config.title}: nothing is lost, the model sees less`;
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: config.description, route: "/", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
  x={config.x}
>
  <Hero />
  <Stats />
  <Projection />
  <HowItWorks />
  <Zones />
  <RecallTools />
  <Packages />
  <FinalCta />
  <Footer
    navigation={data.navigation}
    site={{ description: config.description, title: config.title }}
    slot="footer"
    ui={data.ui}
  />
</PageLayout>

<style>
  /* Landing alignment: the landing export pins every band (nav, hero, sections,
     stats, footer) to 140px gutters on a 1440 artboard, i.e. one shared 1160px
     (72.5rem) content column. Blume's chrome header is full-bleed, so fluid
     gutters pin its content box to that same column on this page only (Astro
     scopes page CSS here; :global reaches the header rendered by Blume's
     layout). .landing-gutter in theme.css is the same measure for the bands. */
  :global(header[data-blume-header]) {
    padding-inline: max(1.5rem, calc((100vw - 72.5rem) / 2));
  }
</style>
