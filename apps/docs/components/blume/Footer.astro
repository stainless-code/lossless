---
import data from "blume:data";
import { contentHref } from "blume/components/content/base-href.ts";
import { EN_UI } from "blume/core/i18n-ui.ts";
import type { UIStrings } from "blume/core/i18n-ui.ts";
import type { Navigation } from "blume/core/types.ts";
import Logo from "blume/components/layout/Logo.astro";

interface Props {
	site: { title: string; description?: string };
	navigation: Navigation;
	ui: UIStrings;
}

const { site, navigation, ui } = Astro.props;

// PageLayout omits `logo`; read it from blume:data to match the header mark.
const logo = data.config.logo;
const repoUrl = navigation.repoUrl ?? "https://github.com/stainless-code/lossless";
const year = new Date().getFullYear();

// Merge over the English defaults so a label missing from a translation still
// renders instead of coming out blank.
const strings = { ...EN_UI, ...ui };

const groups: {
	label: string;
	links: { href: string; label: string; external?: boolean }[];
}[] = [
	{
		label: "Docs",
		links: [
			{ href: contentHref("/guides/pi/getting-started"), label: "Guides" },
			{ href: contentHref("/concepts"), label: "Concepts" },
			{ href: contentHref("/reference/pi/tools"), label: "Reference" },
			{ href: contentHref("/reference/pi/comparison"), label: "Comparison" },
			{ href: contentHref("/roadmap"), label: "Roadmap" },
			{ href: contentHref("/changelog"), label: "Changelog" },
		],
	},
	{
		label: "Packages",
		links: [
			{ href: "https://npmx.dev/package/lossless-core", label: "lossless-core", external: true },
			{ href: "https://npmx.dev/package/pi-lossless", label: "pi-lossless", external: true },
			{ href: "https://npmx.dev/package/opencode-lossless", label: "opencode-lossless", external: true },
		],
	},
	{
		label: "Project",
		links: [
			{ href: repoUrl, label: "GitHub", external: true },
			{ href: `${repoUrl}/blob/main/LICENSE`, label: "MIT license", external: true },
		],
	},
];
---

<footer class="landing-gutter border-border border-t">
  <div class="mx-auto max-w-[1160px] py-14">
    <div class="grid gap-12 lg:grid-cols-[254px_1fr]">
      <div>
        <Logo logo={logo} site={site} />
        <p class="mt-4 max-w-[254px] text-[14px] text-muted-foreground leading-[22px]">
          Open-source Lossless Context Management for coding agents. Aged history
          becomes summary pointers, and every message stays verbatim and searchable.
        </p>
      </div>

      <nav
        aria-label={strings.nav.navigation}
        class="grid grid-cols-2 gap-x-12 gap-y-10 sm:grid-cols-3"
      >
        {
          groups.map((group) => (
            <div>
              <h3 class="font-mono font-normal text-[var(--landing-faint)] text-xs tracking-[0.1em] uppercase">
                {group.label}
              </h3>
              <ul class="mt-3 space-y-3">
                {group.links.map((link) => (
                  <li>
                    <a
                      class="text-base text-muted-foreground transition-colors hover:text-foreground"
                      href={link.href}
                      rel={link.external ? "noreferrer" : undefined}
                      target={link.external ? "_blank" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-11 flex flex-col gap-4 border-border border-t pt-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="font-mono text-[var(--landing-faint)] text-xs">© {year} Lossless · MIT</p>
      <p class="font-mono text-[var(--landing-faint)] text-xs">
        Built and maintained by{" "}
        <a
          class="transition-colors hover:text-foreground"
          href="https://github.com/stainless-code"
          rel="noreferrer"
          target="_blank"
        >
          stainless-code
        </a>
      </p>
    </div>
  </div>
</footer>
