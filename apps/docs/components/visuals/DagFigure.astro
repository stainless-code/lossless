---
/**
 *
 *
 * The accessible name is an `aria-label`, not an SVG `<title>`: the site audit
 * counts `<title>` elements per page and treats a second one as an error.
 */
const leaves = [
	{ id: "#7", span: "e12..e40" },
	{ id: "#8", span: "e41..e103" },
	{ id: "#9", span: "e104..e170" },
	{ id: "#10", span: "e171..e238" },
].map((leaf, index) => ({ ...leaf, x: 112 + index * 228 }));

const condensed = [
	{ id: "#11", span: "e12..e103", x: 112 },
	{ id: "#12", span: "e104..e238", x: 578 },
];

const frontier = { id: "#15", span: "e12..e238" };

const edges = [
	["568,72", "335,172"],
	["568,72", "801,172"],
	["335,244", "221,344"],
	["335,244", "449,344"],
	["801,244", "687,344"],
	["801,244", "915,344"],
] as const;

const depthLabels = [
	{ label: "depth 2", y: 42 },
	{ label: "depth 1", y: 214 },
	{ label: "depth 0", y: 386 },
];
---

<figure class="not-prose mx-auto w-full max-w-[65rem] pt-10 pb-4 @container">
  <div class="hidden @min-[40rem]:block">
    <svg
    aria-label="A summary DAG drawn as a reduced example: four depth-0 leaves over raw messages, two depth-1 nodes (#11 and #12) over those leaves, and one depth-2 frontier node (#15) carried by the projection"
    class="dag w-full overflow-visible"
    role="img"
    viewBox="0 0 1040 416"
    xmlns="http://www.w3.org/2000/svg"
  >
    {
      edges.map(([from, to]) => (
        <line class="dag-edge" x1={from.split(",")[0]} x2={to.split(",")[0]} y1={from.split(",")[1]} y2={to.split(",")[1]} />
      ))
    }

    {
      depthLabels.map((depth) => (
        <text class="dag-depth" x="0" y={depth.y}>
          {depth.label}
        </text>
      ))
    }

    {
      leaves.map((leaf) => (
        <g>
          <rect class="dag-node" height="72" rx="12" width="218" x={leaf.x} y="344" />
          <text class="dag-title" x={leaf.x + 24} y="375">
            {leaf.id} · leaf
          </text>
          <text class="dag-meta" x={leaf.x + 24} y="398">
            3,000 tok · {leaf.span}
          </text>
        </g>
      ))
    }

    {
      condensed.map((node) => (
        <g>
          <rect class="dag-node" height="72" rx="12" width="446" x={node.x} y="172" />
          <text class="dag-title" x={node.x + 24} y="203">
            {node.id} · depth 1
          </text>
          <text class="dag-meta" x={node.x + 24} y="226">
            1,412 tok · {node.span}
          </text>
        </g>
      ))
    }

    <g>
      <rect
        class="dag-node dag-node--frontier"
        height="72"
        rx="12"
        width="446"
        x="345"
        y="0"
      />
      <text class="dag-title" x="369" y="31">{frontier.id} · depth 2</text>
      <text class="dag-meta" x="369" y="54">
        1,930 tok · {frontier.span}
      </text>
    </g>

    <text class="dag-note" x="803" y="29">frontier</text>
    <text class="dag-note-sub" x="803" y="50">carried in the window</text>
    </svg>
  </div>

  <div class="flex flex-col gap-4 @min-[40rem]:hidden">
    <div>
      <p class="font-mono text-muted-foreground text-xs">depth 2 · frontier</p>
      <div class="mt-2 flex flex-wrap gap-2">
        <span class="rounded-md border border-accent/40 bg-accent/10 px-2 py-1 font-mono text-[11px] text-accent">
          {frontier.id} · 1,930 tok · {frontier.span}
        </span>
      </div>
    </div>
    <div>
      <p class="font-mono text-muted-foreground text-xs">depth 1</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {condensed.map((node) => (
          <span class="rounded-md border border-border bg-[var(--landing-surface)] px-2 py-1 font-mono text-[11px] text-foreground">
            {node.id} · 1,412 tok · {node.span}
          </span>
        ))}
      </div>
    </div>
    <div>
      <p class="font-mono text-muted-foreground text-xs">depth 0 · leaves</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {leaves.map((leaf) => (
          <span class="rounded-md border border-border bg-[var(--landing-surface)] px-2 py-1 font-mono text-[11px] text-muted-foreground">
            {leaf.id} · {leaf.span}
          </span>
        ))}
      </div>
    </div>
  </div>

  <figcaption class="mx-auto mt-4 max-w-[700px] text-center text-muted-foreground text-sm leading-[22px]">
    The shape behind a window pointer, drawn with four leaves. Real sessions
    carry many more. Schematic, not to scale.
  </figcaption>
</figure>

<style>
  .dag {
    overflow: visible;
  }

  .dag-edge {
    stroke: var(--landing-faint);
    stroke-linecap: round;
    stroke-width: 1.5;
  }

  .dag-node {
    fill: var(--landing-surface);
    stroke: var(--blume-border);
    stroke-width: 1;
  }

  .dag-node--frontier {
    fill: var(--landing-surface);
    stroke: var(--blume-accent);
    stroke-width: 1.5;
  }

  .dag-title {
    fill: var(--blume-foreground);
    font-family: var(--blume-font-display), ui-sans-serif, sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.3px;
  }

  .dag-meta {
    fill: var(--blume-muted-foreground);
    font-family: var(--blume-font-mono), ui-monospace, monospace;
    font-size: 12px;
  }

  .dag-depth {
    fill: var(--landing-faint);
    font-family: var(--blume-font-mono), ui-monospace, monospace;
    font-size: 12px;
  }

  .dag-note {
    fill: var(--blume-foreground);
    font-family: var(--blume-font-display), ui-sans-serif, sans-serif;
    font-size: 14px;
    font-weight: 600;
  }

  .dag-note-sub {
    fill: var(--blume-muted-foreground);
    font-family: var(--blume-font-body), ui-sans-serif, sans-serif;
    font-size: 14px;
  }
</style>
